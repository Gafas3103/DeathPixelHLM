[sub_resource type="GDScript" id="GDScript_rpqav"]
script/source = "extends CharacterBody2D

@export var bullet_scene: PackedScene
@export var speed: float = 300.0

# Cambia esto a true en el Inspector si quieres que este personaje empiece activo por defecto
@export var is_active: bool = false 

# 1. DETECCIÓN DEL TECLADO PARA DISPARAR
func _unhandled_input(event: InputEvent) -> void:
	# Solo permite disparar si este personaje está controlado actualmente (is_active)
	if is_active and event.is_action_pressed(\"shoot\"):
		shoot()

# 2. LÓGICA DE DISPARO SEGURA (Soluciona el error de \"null instance\")
func shoot() -> void:
	if bullet_scene == null:
		print(\"¡Error: Olvidaste arrastrar la bala al Inspector!\")
		return
		
	var bullet = bullet_scene.instantiate()
	
	# Si Godot encuentra el nodo \"Muzzle\" en tu lista, lo usa.
	# Si no lo encuentra, usa al propio personaje como origen para que el juego NO se rompa.
	if has_node(\"Muzzle\"):
		var muzzle_node = get_node(\"Muzzle\")
		bullet.global_position = muzzle_node.global_position
		bullet.global_rotation = muzzle_node.global_rotation
	else:
		bullet.global_position = global_position
		bullet.global_rotation = global_rotation
	
	get_tree().current_scene.add_child(bullet)

# 3. PROCESO DE MOVIMIENTO, ROTACIÓN Y CAMBIO DE PERSONAJE
func _physics_process(delta: float) -> void:
	# Al presionar tu acción (la tecla E), el personaje alterna entre activo e inactivo
	if Input.is_action_just_pressed(\"action\"):
		is_active = not is_active

	if is_active:
		# Rota el personaje hacia la posición del puntero del ratón
		look_at(get_global_mouse_position())

		var direction = Vector2.ZERO

		# Movimiento lineal basado en hacia dónde está mirando el personaje
		if Input.is_action_pressed(\"move_up\"):
			direction = transform.x
		elif Input.is_action_pressed(\"move_down\"):
			direction = -transform.x

		velocity = direction * speed
	else:
		# Si está inactivo, se detiene por completo para cederle el turno al otro personaje
		velocity = Vector2.ZERO 

	move_and_slide()
"

